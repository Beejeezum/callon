{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://callon.local/schemas/ai-ask-draft.schema.json",
  "title": "Call On AI Ask Draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "title",
    "askType",
    "summary",
    "needs",
    "fieldConfidence",
    "riskFlags"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "askType": {
      "enum": ["quick_need", "project", "event", "offer"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "startsAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "neededBy": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "expiresAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "timezone": {
      "type": ["string", "null"],
      "maxLength": 64
    },
    "generalLocation": {
      "type": ["string", "null"],
      "maxLength": 120
    },
    "needs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "description", "quantity"],
        "properties": {
          "kind": {
            "enum": [
              "item",
              "material",
              "volunteer_help",
              "advice",
              "skill",
              "alternative"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999
          },
          "unit": {
            "type": ["string", "null"],
            "maxLength": 40
          },
          "startsAt": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "neededBy": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "riskLevelSuggestion": {
            "enum": ["low", "moderate", "high", "prohibited", "unknown"]
          }
        }
      }
    },
    "fieldConfidence": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "riskFlags": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 120
      },
      "maxItems": 20
    },
    "clarifyingQuestions": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 240
      },
      "maxItems": 5
    }
  }
}
